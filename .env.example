# Copy to .env.local (git-ignored) and fill in what you need. Everything is optional:
# without a key, each feature falls back gracefully.

# Canonical site address, used for links, the sitemap and link previews.
NEXT_PUBLIC_SITE_URL=https://baibhav-os.vercel.app

# Contact form (Resend, https://resend.com). Without RESEND_API_KEY the form tells
# visitors to email or message on LinkedIn instead.
RESEND_API_KEY=
CONTACT_TO=pathak.ba@northeastern.edu
# A sender on a domain verified in Resend; defaults to Resend's shared test sender.
CONTACT_FROM=

# Optional: raises GitHub's API limit from 60 to 5,000 requests an hour.
GITHUB_TOKEN=

# Optional: raises the MBTA V3 API rate limit (free key from https://api-v3.mbta.com).
MBTA_API_KEY=
